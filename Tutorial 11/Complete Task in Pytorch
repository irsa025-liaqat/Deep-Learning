from torchvision.models.detection.faster_rcnn import FastRCNNPredictor
from torchvision.models.detection.mask_rcnn import MaskRCNNPredictor

NUM_CLASSES = len(CLASSES)      # background + 3


def build_maskrcnn(num_classes):
    # my images are small (~300 px) so I use smaller input sizes than the default (800) to train faster
    model = maskrcnn_resnet50_fpn(weights=MaskRCNN_ResNet50_FPN_Weights.DEFAULT, min_size=400, max_size=600)

    # new box/class head
    in_features = model.roi_heads.box_predictor.cls_score.in_features
    model.roi_heads.box_predictor = FastRCNNPredictor(in_features, num_classes)

    # new mask head
    in_features_mask = model.roi_heads.mask_predictor.conv5_mask.in_channels
    model.roi_heads.mask_predictor = MaskRCNNPredictor(in_features_mask, 256, num_classes)
    return model


mr_model = build_maskrcnn(NUM_CLASSES).to(device)
print("trainable parameters:", sum(p.numel() for p in mr_model.parameters() if p.requires_grad))
############################# Train ##############################################
EPOCHS = 10
params = [p for p in mr_model.parameters() if p.requires_grad]
optimizer = torch.optim.SGD(params, lr=0.005, momentum=0.9, weight_decay=0.0005)
scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=5, gamma=0.1)     # lower the lr after 5 epochs


def to_device(imgs, targets):
    imgs = [i.to(device) for i in imgs]
    targets = [{k: v.to(device) for k, v in t.items()} for t in targets]
    return imgs, targets


history = {"train_loss": [], "val_loss": []}
for epoch in range(EPOCHS):
    t0 = time.time()
    mr_model.train()
    running = 0.0
    for imgs, targets in train_loader:
        imgs, targets = to_device(imgs, targets)
        loss_dict = mr_model(imgs, targets)         # in train mode the model returns its losses
        loss = sum(loss_dict.values())
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        running += loss.item()
    scheduler.step()

    # validation loss (model stays in train mode so it returns losses, but no gradients are computed)
    val_running = 0.0
    with torch.no_grad():
        for imgs, targets in val_loader:
            imgs, targets = to_device(imgs, targets)
            val_running += sum(mr_model(imgs, targets).values()).item()

    history["train_loss"].append(running / len(train_loader))
    history["val_loss"].append(val_running / len(val_loader))
    print(f"Epoch {epoch+1:2d}/{EPOCHS} | train loss {history['train_loss'][-1]:.4f} | "
          f"val loss {history['val_loss'][-1]:.4f} | {time.time() - t0:.0f}s")

plt.plot(history["train_loss"], label="train"); plt.plot(history["val_loss"], label="val")
plt.title("Mask R-CNN fine-tuning loss"); plt.xlabel("epoch"); plt.legend(); plt.show()
