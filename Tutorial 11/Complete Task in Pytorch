def match_stats(pred_boxes, pred_names, gt_boxes, gt_names, eval_names, iou_thr=0.5):
    # returns {class: [TP, FP, FN]} for ONE image
    stats = {n: [0, 0, 0] for n in eval_names}
    for n in eval_names:
        p = [b for b, nm in zip(pred_boxes, pred_names) if nm == n]     # already sorted by score
        g = [b for b, nm in zip(gt_boxes, gt_names) if nm == n]
        if len(g) == 0:
            stats[n][1] += len(p); continue
        if len(p) == 0:
            stats[n][2] += len(g); continue
        iou = box_iou(torch.tensor(p, dtype=torch.float32), torch.tensor(g, dtype=torch.float32)).numpy()
        matched, tp = set(), 0
        for i in range(len(p)):
            for j in np.argsort(-iou[i]):
                if iou[i, j] < iou_thr:
                    break
                if j not in matched:
                    matched.add(j); tp += 1
                    break
        stats[n][0] += tp
        stats[n][1] += len(p) - tp
        stats[n][2] += len(g) - tp
    return stats


def evaluate_detector(model, paths, label_to_name, eval_names, score_thr=0.5):
    # label_to_name: function that turns the model's label id into one of MY class names (or None to ignore)
    total = {n: [0, 0, 0] for n in eval_names}
    for p in paths:
        img, gt_boxes, gt_names, _ = load_item(p)
        res = run_maskrcnn(model, img, score_thr)
        pr_boxes, pr_names = [], []
        for b, l in zip(res["boxes"].tolist(), res["labels"].tolist()):
            nm = label_to_name(l)
            if nm is not None:
                pr_boxes.append(b); pr_names.append(nm)
        s = match_stats(pr_boxes, pr_names, gt_boxes, gt_names, eval_names)
        for n in eval_names:
            for k in range(3):
                total[n][k] += s[n][k]
    return total


def print_table(total, title):
    print(title)
    print(f"{'class':8s} {'TP':>4s} {'FP':>4s} {'FN':>4s} {'precision':>10s} {'recall':>8s}")
    for n, (tp, fp, fn) in total.items():
        prec = tp / max(tp + fp, 1); rec = tp / max(tp + fn, 1)
        print(f"{n:8s} {tp:4d} {fp:4d} {fn:4d} {prec:10.3f} {rec:8.3f}")
    print()


