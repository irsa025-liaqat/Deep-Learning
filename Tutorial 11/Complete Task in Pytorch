class VOCInstanceDataset(Dataset):
    # gives (image, target) in the format Mask R-CNN wants
    def __init__(self, paths, augment=False):
        self.paths = paths
        self.augment = augment

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        img = Image.open(self.paths[idx]).convert("RGB")
        w, h = img.size
        boxes, names = read_voc(os.path.splitext(self.paths[idx])[0] + ".xml")

        boxes_t = torch.tensor(boxes, dtype=torch.float32).reshape(-1, 4)
        labels_t = torch.tensor([CLASS_TO_ID[n] for n in names], dtype=torch.int64)

        # one binary mask per object (a filled rectangle)
        masks_t = torch.zeros((len(boxes), h, w), dtype=torch.uint8)
        for k, (x1, y1, x2, y2) in enumerate(boxes):
            xi1, yi1 = int(round(x1)), int(round(y1))
            xi2, yi2 = max(int(round(x2)), xi1 + 1), max(int(round(y2)), yi1 + 1)
            masks_t[k, yi1:yi2, xi1:xi2] = 1

        if self.augment and random.random() < 0.5:          # horizontal flip
            img = TF.hflip(img)
            masks_t = masks_t.flip(-1)
            if len(boxes_t):
                boxes_t = torch.stack([w - boxes_t[:, 2], boxes_t[:, 1], w - boxes_t[:, 0], boxes_t[:, 3]], dim=1)

        target = {"boxes": boxes_t, "labels": labels_t, "masks": masks_t}
        return TF.to_tensor(img), target


def collate_fn(batch):
    return tuple(zip(*batch))          # detection models want lists, not stacked tensors


train_loader = DataLoader(VOCInstanceDataset(train_paths, augment=True), batch_size=4, shuffle=True, collate_fn=collate_fn)
val_loader   = DataLoader(VOCInstanceDataset(val_paths),                 batch_size=4, shuffle=False, collate_fn=collate_fn)
