def deeplab_predict(pil_image):
    input_tensor = preprocess(pil_image).unsqueeze(0).to(device)      # add batch dimension
    with torch.no_grad():
        output = dl_model(input_tensor)["out"][0]                     # (21, H, W)
    return output.argmax(0).cpu().numpy()                             # class with the highest score per pixel


