def read_voc(xml_path):
    # returns a list of boxes [x1, y1, x2, y2] and a list of class names for one image
    root = ET.parse(xml_path).getroot()
    boxes, names = [], []
    for obj in root.findall("object"):
        name = obj.find("name").text.strip()
        b = obj.find("bndbox")
        x1, y1, x2, y2 = [float(b.find(k).text) for k in ("xmin", "ymin", "xmax", "ymax")]
        if x2 <= x1 or y2 <= y1:          # skip broken boxes
            continue
        if name in CLASS_TO_ID:
            boxes.append([x1, y1, x2, y2]); names.append(name)
    return boxes, names


def make_semantic_mask(h, w, boxes, names):
    m = np.zeros((h, w), dtype=np.uint8)
    for (x1, y1, x2, y2), n in zip(boxes, names):
        m[int(y1):int(y2), int(x1):int(x2)] = CLASS_TO_ID[n]
    return m


def load_item(img_path):
    # one image (PIL), its boxes/names, and its semantic mask, all at the ORIGINAL resolution
    img = Image.open(img_path).convert("RGB")
    boxes, names = read_voc(os.path.splitext(img_path)[0] + ".xml")
    w, h = img.size
    return img, boxes, names, make_semantic_mask(h, w, boxes, names)


