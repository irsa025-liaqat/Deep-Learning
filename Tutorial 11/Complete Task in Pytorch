def run_maskrcnn(model, pil_image, score_thr=0.5):
    # Mask R-CNN takes images as tensors in [0, 1] (it normalizes internally)
    x = TF.to_tensor(pil_image).to(device)
    with torch.no_grad():
        out = model([x])[0]
    keep = out["scores"] >= score_thr
    return {k: v[keep].cpu() for k, v in out.items()}      # boxes, labels, scores, masks


INSTANCE_COLORS = [(1, 0.2, 0.2), (0.2, 0.5, 1), (0.2, 0.8, 0.3), (1, 0.8, 0.1), (0.8, 0.3, 0.9), (0.1, 0.8, 0.8)]

def show_instances(ax, pil_image, result, class_names, title=""):
    # draws the masks, boxes and labels on top of the image
    img = np.array(pil_image).astype(np.float32) / 255.0
    overlay = img.copy()
    for i in range(len(result["boxes"])):
        color = np.array(INSTANCE_COLORS[i % len(INSTANCE_COLORS)])
        m = result["masks"][i, 0].numpy() > 0.5
        overlay[m] = 0.5 * overlay[m] + 0.5 * color
    ax.imshow(overlay)
    for i in range(len(result["boxes"])):
        x1, y1, x2, y2 = result["boxes"][i].tolist()
        color = INSTANCE_COLORS[i % len(INSTANCE_COLORS)]
        ax.add_patch(patches.Rectangle((x1, y1), x2 - x1, y2 - y1, fill=False, edgecolor=color, linewidth=2))
        label = f"{class_names[int(result['labels'][i])]} {result['scores'][i]:.2f}"
        ax.text(x1, max(y1 - 3, 8), label, color="white", fontsize=8,
                bbox=dict(facecolor=color, alpha=0.8, pad=1, edgecolor="none"))
    ax.set_title(title); ax.axis("off")


